{
  "name": "performance-review-bot",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:local": "bash scripts/dev-local.sh",
    "db:local": "docker compose up -d postgres",
    "tunnel": "ngrok http 8080",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:quiet": "vitest run --reporter=dot",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.2",
    "googleapis": "^173.0.0",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@11.5.1"
}
