generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model ReviewerToken {
  chatUserId      String   @id
  googleUserEmail String
  refreshToken    String
  createdAt       DateTime
}

model ReviewerSettings {
  chatUserId             String   @id
  rootFolderId           String
  taskCollectDaysBefore  Int
  taskCheckDaysBefore    Int
  taskPrepareDaysBefore  Int
  taskReminderTime       String
  reviewIntervalMonths   Int      @default(6)
  updatedAt              DateTime
}
